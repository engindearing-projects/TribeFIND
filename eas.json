{
  "cli": {
    "version": ">= 16.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.18.0",
      "cache": {
        "disabled": true
      },
      "env": {
        "GOOGLE_SERVICE_INFO_PLIST": "@GOOGLE_SERVICE_INFO_PLIST",
        "GOOGLE_PLACES_API_KEY": "@GOOGLE_PLACES_API_KEY",
        "EXPO_PUBLIC_SUPABASE_URL": "@EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "@EXPO_PUBLIC_SUPABASE_ANON_KEY",
        "EXPO_PUBLIC_TWITTER_CLIENT_ID": "@EXPO_PUBLIC_TWITTER_CLIENT_ID"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICE_INFO_PLIST": "@GOOGLE_SERVICE_INFO_PLIST",
        "GOOGLE_PLACES_API_KEY": "@GOOGLE_PLACES_API_KEY",
        "EXPO_PUBLIC_SUPABASE_URL": "@EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "@EXPO_PUBLIC_SUPABASE_ANON_KEY",
        "EXPO_PUBLIC_TWITTER_CLIENT_ID": "@EXPO_PUBLIC_TWITTER_CLIENT_ID"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "GOOGLE_SERVICE_INFO_PLIST": "@GOOGLE_SERVICE_INFO_PLIST",
        "GOOGLE_PLACES_API_KEY": "@GOOGLE_PLACES_API_KEY",
        "EXPO_PUBLIC_SUPABASE_URL": "@EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "@EXPO_PUBLIC_SUPABASE_ANON_KEY",
        "EXPO_PUBLIC_TWITTER_CLIENT_ID": "@EXPO_PUBLIC_TWITTER_CLIENT_ID"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "j.wylie.81@gmail.com",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_TEAM_ID",
        "sku": "tribefind-ios-2024",
        "language": "en-US",
        "companyName": "TribeFind",
        "appName": "TribeFind"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    }
  }
}
