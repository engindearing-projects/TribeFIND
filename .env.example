# Environment Variables for TribeFIND
# Copy this file to .env.development and fill in your actual values

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Twitter OAuth Configuration
EXPO_PUBLIC_TWITTER_CLIENT_ID=your-twitter-client-id-here

# Google Places API (for map features)
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Note: Never commit actual .env files to version control
# Your real credentials should only be in .env.development (which is gitignored)
# For EAS builds, set these as EAS Secrets: eas secret:create --name KEY_NAME --value "value"
